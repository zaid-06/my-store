  {
    "compilerOptions": {
      "target": "ES2020",
      "module": "CommonJS",
      "rootDir": ".",
      "outDir": "dist",
      "strict": true,
      "esModuleInterop": true,
      "moduleResolution": "node",
      "skipLibCheck": true,
      "types": ["node"],
      "baseUrl": ".",
      "typeRoots": ["./node_modules/@types", "./src/types"],
      "paths": {
        "@/*": ["src/*"]
      }
    },
    "include": ["src", "tests"]
  }
